{
  "manifest_version": 3,
  "name": "HAuto Recruiting Assistant",
  "version": "1.0.0",
  "description": "사내 시스템, 사람인, 잡코리아, 구글 스프레드시트, Notion, Gemini API 연동 채용 업무 자동화 비서",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.saramin.co.kr/*",
    "https://*.jobkorea.co.kr/*",
    "https://*.notion.so/*",
    "https://sheets.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.saramin.co.kr/*",
        "https://*.jobkorea.co.kr/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
